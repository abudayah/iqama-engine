# ─────────────────────────────────────────────────────────────────────────────
# iqama-engine — Environment Variables
# Copy this file to .env and fill in the required values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Masjid Location ──────────────────────────────────────────────────────────

# Latitude of the masjid used for astronomical prayer-time calculation.
# Default: Masjid al-Hidayah, 2626 Kingsway Ave, Port Coquitlam, BC
MASJID_LATITUDE=49.2652047

# Longitude of the masjid used for astronomical prayer-time calculation.
# Default: Masjid al-Hidayah, 2626 Kingsway Ave, Port Coquitlam, BC
MASJID_LONGITUDE=-122.7878735

# IANA timezone string for the masjid's local time.
# Used for DST detection and HH:mm formatting.
# Default: America/Vancouver
MASJID_TIMEZONE=America/Vancouver

# ── Database (SQLite) ──────────────────────────────────────────────────────────

# SQLite database file path
# Example: file:./prisma/db.sqlite
DATABASE_URL=file:./prisma/db.sqlite

# ── Admin Security ────────────────────────────────────────────────────────────

# Password for authenticating admin endpoints (override management).
# Required for all /api/v1/admin/* endpoints.
ADMIN_PASSWORD=

# ── CORS ─────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed origins for the browser CORS policy.
# Use '*' to allow all origins (dev only). Leave empty to disable CORS headers.
# Example: CORS_ORIGIN=http://localhost:5173,https://prayers.example.com
CORS_ORIGIN=

# ── Iqama rules ──────────────────────────────────────────────────────────────

# The Iqama rules always come from the database (IqamaRuleVersion, seeded by
# `npx prisma db seed`, edited through /api/v1/admin/iqama-rules).
# IQAMA_RULES and IQAMA_RULES_CUTOVER no longer exist; if they are still set in
# the environment they are ignored (the app logs one info line at startup).

# ── Reverse proxy ────────────────────────────────────────────────────────────

# Rate limiting is per client IP. Behind a reverse proxy (nginx, cPanel/Apache,
# a load balancer) every request looks like it comes from the proxy, so all
# clients would share one limit. Set TRUST_PROXY so the real client IP is read
# from X-Forwarded-For. Recommended values:
#   loopback          the proxy runs on the same host (e.g. Apache/Passenger)
#   10.0.0.5,10.0.0.6 explicit proxy IPs or CIDRs (comma-separated)
# Empty/false (default) ignores X-Forwarded-For.
# A number of hops (e.g. 1) or 'true' also work, but they trust X-Forwarded-For
# from ANY sender, so a client can fake its IP and dodge the rate limits if the
# app port is reachable directly. Use them only if the port is reachable solely
# through the proxy. The app logs a warning at startup for these values.
# https://expressjs.com/en/guide/behind-proxies.html
TRUST_PROXY=
